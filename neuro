#!/bin/bash

# Neuro AI VTuber - Control Script
# Simple control script for managing the Neuro AI VTuber application

set -e

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_NAME="venv"
PID_FILE="$SCRIPT_DIR/.neuro.pid"
LOG_FILE="$SCRIPT_DIR/neuro.log"
MAIN_SCRIPT="main.py"

# Detect OS
OS=$(uname -s)
case "$OS" in
    Linux*)     OS_TYPE="Linux";;
    MINGW*|MSYS*|CYGWIN*)     OS_TYPE="Windows";;
    *)          OS_TYPE="Unknown";;
esac

# Print functions
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

# Check if virtual environment exists
check_venv() {
    if [ ! -d "$SCRIPT_DIR/$VENV_NAME" ]; then
        print_error "Virtual environment not found. Please run install.sh first."
        exit 1
    fi
}

# Activate virtual environment
activate_venv() {
    if [ "$OS_TYPE" = "Windows" ]; then
        source "$SCRIPT_DIR/$VENV_NAME/Scripts/activate"
    else
        source "$SCRIPT_DIR/$VENV_NAME/bin/activate"
    fi
}

# Check if application is running
is_running() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            return 0
        else
            # PID file exists but process is not running
            rm -f "$PID_FILE"
            return 1
        fi
    fi
    return 1
}

# Start the application
start_app() {
    print_info "Starting Neuro AI VTuber..."

    check_venv

    if is_running; then
        print_warning "Neuro is already running (PID: $(cat $PID_FILE))"
        exit 1
    fi

    cd "$SCRIPT_DIR"
    activate_venv

    print_info "Checking prerequisites..."

    # Check if .env exists
    if [ ! -f ".env" ]; then
        print_error ".env file not found. Please run install.sh or create .env manually."
        exit 1
    fi

    # Check if main.py exists
    if [ ! -f "$MAIN_SCRIPT" ]; then
        print_error "$MAIN_SCRIPT not found."
        exit 1
    fi

    echo ""
    print_info "Starting application in foreground mode..."
    print_info "Press CTRL+C to stop"
    echo ""
    print_info "Log file: $LOG_FILE"
    echo ""

    # Start the application
    python3 "$MAIN_SCRIPT" 2>&1 | tee "$LOG_FILE"
}

# Start the application in background
start_background() {
    print_info "Starting Neuro AI VTuber in background..."

    check_venv

    if is_running; then
        print_warning "Neuro is already running (PID: $(cat $PID_FILE))"
        exit 1
    fi

    cd "$SCRIPT_DIR"
    activate_venv

    print_info "Checking prerequisites..."

    # Check if .env exists
    if [ ! -f ".env" ]; then
        print_error ".env file not found. Please run install.sh or create .env manually."
        exit 1
    fi

    # Check if main.py exists
    if [ ! -f "$MAIN_SCRIPT" ]; then
        print_error "$MAIN_SCRIPT not found."
        exit 1
    fi

    # Start in background
    nohup python3 "$MAIN_SCRIPT" > "$LOG_FILE" 2>&1 &
    PID=$!
    echo $PID > "$PID_FILE"

    sleep 2

    if is_running; then
        print_success "Neuro started in background (PID: $PID)"
        print_info "Log file: $LOG_FILE"
        print_info "Use './neuro logs' to view logs"
        print_info "Use './neuro stop' to stop"
    else
        print_error "Failed to start Neuro. Check logs: $LOG_FILE"
        rm -f "$PID_FILE"
        exit 1
    fi
}

# Stop the application
stop_app() {
    print_info "Stopping Neuro AI VTuber..."

    if ! is_running; then
        print_warning "Neuro is not running"
        exit 1
    fi

    PID=$(cat "$PID_FILE")
    print_info "Sending SIGTERM to process $PID..."

    kill -TERM "$PID" 2>/dev/null || true

    # Wait for graceful shutdown
    for i in {1..10}; do
        if ! ps -p "$PID" > /dev/null 2>&1; then
            rm -f "$PID_FILE"
            print_success "Neuro stopped successfully"
            exit 0
        fi
        sleep 1
    done

    # Force kill if still running
    print_warning "Graceful shutdown failed, forcing stop..."
    kill -KILL "$PID" 2>/dev/null || true
    rm -f "$PID_FILE"
    print_success "Neuro stopped (forced)"
}

# Restart the application
restart_app() {
    print_info "Restarting Neuro AI VTuber..."
    if is_running; then
        stop_app
        sleep 2
    fi
    start_background
}

# Show application status
show_status() {
    echo ""
    echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║         Neuro AI VTuber - Status                          ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""

    if is_running; then
        PID=$(cat "$PID_FILE")
        print_success "Status: RUNNING"
        print_info "PID: $PID"

        # Get process info
        if command -v ps &> /dev/null; then
            UPTIME=$(ps -p "$PID" -o etime= 2>/dev/null | xargs || echo "Unknown")
            MEM=$(ps -p "$PID" -o rss= 2>/dev/null | xargs || echo "Unknown")
            if [ "$MEM" != "Unknown" ]; then
                MEM="$((MEM / 1024)) MB"
            fi
            print_info "Uptime: $UPTIME"
            print_info "Memory: $MEM"
        fi

        print_info "Log file: $LOG_FILE"
    else
        print_warning "Status: NOT RUNNING"
    fi
    echo ""
}

# Show logs
show_logs() {
    if [ ! -f "$LOG_FILE" ]; then
        print_warning "No log file found: $LOG_FILE"
        exit 1
    fi

    if [ "$1" = "-f" ] || [ "$1" = "--follow" ]; then
        tail -f "$LOG_FILE"
    else
        tail -n 50 "$LOG_FILE"
    fi
}

# Show help
show_help() {
    echo ""
    echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║         Neuro AI VTuber - Control Script                  ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo "Usage: ./neuro <command>"
    echo ""
    echo "Commands:"
    echo "  start         Start Neuro in foreground (interactive mode)"
    echo "  background    Start Neuro in background (daemon mode)"
    echo "  stop          Stop Neuro"
    echo "  restart       Restart Neuro (background mode)"
    echo "  status        Show Neuro status"
    echo "  logs          Show recent logs (last 50 lines)"
    echo "  logs -f       Follow logs in real-time"
    echo "  help          Show this help message"
    echo ""
    echo "Examples:"
    echo "  ./neuro start       # Start interactively"
    echo "  ./neuro background  # Start as daemon"
    echo "  ./neuro stop        # Stop the application"
    echo "  ./neuro status      # Check if running"
    echo "  ./neuro logs -f     # Watch logs live"
    echo ""
}

# Main command handler
case "$1" in
    start)
        start_app
        ;;
    background|daemon)
        start_background
        ;;
    stop)
        stop_app
        ;;
    restart)
        restart_app
        ;;
    status)
        show_status
        ;;
    logs)
        show_logs "$2"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        if [ -z "$1" ]; then
            print_error "No command specified"
        else
            print_error "Unknown command: $1"
        fi
        echo ""
        echo "Run './neuro help' for usage information"
        exit 1
        ;;
esac
